INSERT INTO users (login, password, full_name, role)
SELECT
    -- Короткий логин: u1, u2, u3...
    'u' || seq,
    
    -- Очень короткий пароль: p1, p2, p3...
    'p' || seq,
    
    -- full_name как массив строк [Фамилия, Имя, Отчество]
    ARRAY[
        (ARRAY['Иванов', 'Петров', 'Сидоров', 'Кузнецов', 'Смирнов', 'Попов', 'Васильев', 'Новиков'])[(seq % 8) + 1],
        (ARRAY['Иван', 'Петр', 'Алексей', 'Дмитрий', 'Сергей', 'Андрей', 'Михаил', 'Николай'])[(seq % 8) + 1],
        (ARRAY['Иванович', 'Петрович', 'Алексеевич', 'Дмитриевич', 'Сергеевич', 'Андреевич', 'Михайлович', 'Николаевич'])[(seq % 8) + 1]
    ]::VARCHAR[],
    
    -- Роль: первые 10 - преподаватели, остальные - студенты
    CASE 
        WHEN seq <= 10 THEN 'преподаватель'
        ELSE 'студент'
    END

FROM generate_series(1, 50) as seq;
